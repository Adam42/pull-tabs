{
    "name": "pulltabs",
    "version": "0.21.0",
    "description": "A browser extension to gather the current window's tabs and offer options to save them to disk.",
    "main": "src/js/popup.js",
    "directories": {
        "test": "tests"
    },
    "dependencies": {
        "bootswatch": "^3.3",
        "sanitize-filename-ts": "^1.0.2",
        "simple-icons": "^1.6.4",
        "webextension-polyfill": "^0.4.0"
    },
    "devDependencies": {
        "@babel/core": "^7.21.4",
        "@babel/preset-env": "^7.21.4",
        "babel-jest": "^28.0.0",
        "esbuild": "^0.25.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^28.0.0",
        "jest-environment-jsdom": "^28.1.3",
        "prettier": "^3.9.4"
    },
    "scripts": {
        "test": "jest",
        "dev": "node build.js",
